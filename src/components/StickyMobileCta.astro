---
import { siteConfig } from '../lib/config';

const phoneHref = `tel:${siteConfig.phone.replace(/\s+/g, '')}`;
---

<div
  class="fixed bottom-0 inset-x-0 z-50 md:hidden border-t border-neutral-200 bg-white/95 backdrop-blur-sm px-4 py-3 pb-[max(0.75rem,env(safe-area-inset-bottom))] shadow-[0_-4px_20px_rgba(0,0,0,0.08)] dark:border-neutral-800 dark:bg-neutral-950/95"
  role="region"
  aria-label="Azioni rapide"
>
  <div class="flex gap-3 max-w-lg mx-auto">
    <a
      href={phoneHref}
      data-track-event="phone_click"
      data-track-location="sticky_mobile"
      class="flex-1 inline-flex items-center justify-center gap-2 rounded-xl border border-brand-primary/30 bg-white px-4 py-3 text-sm font-semibold text-brand-primary dark:bg-neutral-900 dark:text-brand-light"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
      </svg>
      Chiama
    </a>
    <a
      href="/contatti"
      data-track-event="contact_click"
      data-track-location="sticky_mobile"
      class="flex-1 inline-flex items-center justify-center gap-2 rounded-xl bg-brand-primary px-4 py-3 text-sm font-semibold text-white shadow-lg shadow-brand-primary/25 hover:bg-brand-light"
    >
      Contatti
    </a>
  </div>
</div>

<div class="h-20 md:hidden" aria-hidden="true"></div>
