---
import { siteConfig } from '../lib/config';

const gaMeasurementId = siteConfig.analytics?.gaMeasurementId?.trim() ?? '';
const umamiWebsiteId = '3c0958d9-8d27-46ba-b14e-cc28bb7dd035';
const umamiScriptSrc = 'https://umami.bitora.it/script.js';
const hasAnalytics = Boolean(gaMeasurementId || umamiWebsiteId);
---

<div
  id="cookie-consent-banner"
  class="fixed inset-x-0 bottom-0 z-[110] hidden p-4 pb-[max(1rem,env(safe-area-inset-bottom))] md:bottom-4 md:left-4 md:right-auto md:max-w-md"
  role="dialog"
  aria-labelledby="cookie-consent-title"
  aria-describedby="cookie-consent-desc"
  aria-hidden="true"
>
  <div class="rounded-2xl border border-neutral-200 bg-white p-5 shadow-2xl dark:border-neutral-700 dark:bg-neutral-900">
    <h2 id="cookie-consent-title" class="text-base font-semibold text-neutral-900 dark:text-white">
      Cookie e privacy
    </h2>
    <p id="cookie-consent-desc" class="mt-2 text-sm text-neutral-600 dark:text-neutral-300 leading-relaxed">
      Usiamo cookie tecnici necessari al funzionamento del sito. Con il tuo consenso attiviamo anche strumenti
      statistici (Google Analytics e Umami) per migliorare l’esperienza.
      <a href="/cookie" class="text-brand-primary underline underline-offset-2 hover:text-brand-light">Cookie Policy</a>
      ·
      <a href="/privacy" class="text-brand-primary underline underline-offset-2 hover:text-brand-light">Privacy</a>
    </p>

    <div id="cookie-consent-details" class="mt-4 hidden space-y-3 border-t border-neutral-100 pt-4 dark:border-neutral-800">
      <label class="flex items-start gap-3 cursor-not-allowed opacity-80">
        <input type="checkbox" checked disabled class="mt-1 h-4 w-4 rounded border-neutral-300 text-brand-primary" />
        <span class="text-sm">
          <span class="font-medium text-neutral-900 dark:text-white">Necessari</span>
          <span class="block text-neutral-500 dark:text-neutral-400">Sempre attivi (sicurezza, preferenze tema).</span>
        </span>
      </label>
      {hasAnalytics && (
        <label class="flex items-start gap-3 cursor-pointer">
          <input id="cookie-consent-analytics" type="checkbox" class="mt-1 h-4 w-4 rounded border-neutral-300 text-brand-primary focus:ring-brand-primary/30" />
          <span class="text-sm">
            <span class="font-medium text-neutral-900 dark:text-white">Statistici</span>
            <span class="block text-neutral-500 dark:text-neutral-400">
              Google Analytics{gaMeasurementId ? '' : ' (non configurato)'} e Umami — dati aggregati, IP anonimizzato su GA.
            </span>
          </span>
        </label>
      )}
    </div>

    <div class="mt-4 flex flex-col gap-2 sm:flex-row sm:flex-wrap">
      <button
        type="button"
        id="cookie-consent-accept"
        class="inline-flex flex-1 items-center justify-center rounded-xl bg-brand-primary px-4 py-2.5 text-sm font-semibold text-white hover:bg-brand-light transition"
      >
        Accetta tutti
      </button>
      <button
        type="button"
        id="cookie-consent-reject"
        class="inline-flex flex-1 items-center justify-center rounded-xl border border-neutral-200 bg-white px-4 py-2.5 text-sm font-semibold text-neutral-700 hover:border-brand-primary hover:text-brand-primary transition dark:border-neutral-700 dark:bg-neutral-800 dark:text-neutral-200"
      >
        Solo necessari
      </button>
      <button
        type="button"
        id="cookie-consent-customize"
        class="inline-flex flex-1 items-center justify-center rounded-xl px-4 py-2.5 text-sm font-medium text-neutral-600 underline-offset-2 hover:underline dark:text-neutral-400"
      >
        Personalizza
      </button>
      <button
        type="button"
        id="cookie-consent-save"
        class="hidden inline-flex flex-1 items-center justify-center rounded-xl bg-brand-primary px-4 py-2.5 text-sm font-semibold text-white hover:bg-brand-light transition"
      >
        Salva preferenze
      </button>
    </div>
  </div>
</div>

<script
  is:inline
  define:vars={{ gaMeasurementId, umamiWebsiteId, umamiScriptSrc, hasAnalytics }}
>
  (() => {
    const STORAGE_KEY = 'cookie-consent-v1';
    const banner = document.getElementById('cookie-consent-banner');
    const details = document.getElementById('cookie-consent-details');
    const analyticsCheckbox = document.getElementById('cookie-consent-analytics');
    const btnAccept = document.getElementById('cookie-consent-accept');
    const btnReject = document.getElementById('cookie-consent-reject');
    const btnCustomize = document.getElementById('cookie-consent-customize');
    const btnSave = document.getElementById('cookie-consent-save');

    if (!banner) return;

    function readConsent() {
      try {
        const raw = localStorage.getItem(STORAGE_KEY);
        if (!raw) return null;
        return JSON.parse(raw);
      } catch {
        return null;
      }
    }

    function writeConsent(analytics) {
      localStorage.setItem(
        STORAGE_KEY,
        JSON.stringify({
          necessary: true,
          analytics: Boolean(analytics),
          updatedAt: new Date().toISOString(),
        })
      );
    }

    function loadGoogleAnalytics() {
      if (!gaMeasurementId || window.__gaLoaded) return;
      window.__gaLoaded = true;
      window.dataLayer = window.dataLayer || [];
      window.gtag = function () {
        window.dataLayer.push(arguments);
      };
      window.gtag('consent', 'default', {
        analytics_storage: 'denied',
        ad_storage: 'denied',
      });
      var s = document.createElement('script');
      s.async = true;
      s.src = 'https://www.googletagmanager.com/gtag/js?id=' + encodeURIComponent(gaMeasurementId);
      s.onload = function () {
        window.gtag('js', new Date());
        window.gtag('consent', 'update', { analytics_storage: 'granted' });
        window.gtag('config', gaMeasurementId, { anonymize_ip: true });
      };
      document.head.appendChild(s);
    }

    function loadUmami() {
      if (!umamiWebsiteId || window.__umamiLoaded) return;
      window.__umamiLoaded = true;
      var s = document.createElement('script');
      s.defer = true;
      s.src = umamiScriptSrc;
      s.setAttribute('data-website-id', umamiWebsiteId);
      document.head.appendChild(s);
    }

    function applyConsent(consent) {
      if (consent && consent.analytics) {
        loadGoogleAnalytics();
        loadUmami();
      }
      window.__cookieAnalyticsAllowed = Boolean(consent && consent.analytics);
    }

    function hideBanner() {
      banner.classList.add('hidden');
      banner.setAttribute('aria-hidden', 'true');
    }

    function showBanner() {
      banner.classList.remove('hidden');
      banner.setAttribute('aria-hidden', 'false');
    }

    function saveAndClose(analytics) {
      writeConsent(analytics);
      applyConsent({ analytics: analytics });
      hideBanner();
    }

    var existing = readConsent();
    if (existing) {
      applyConsent(existing);
      hideBanner();
    } else {
      showBanner();
    }

    btnAccept?.addEventListener('click', function () {
      saveAndClose(hasAnalytics);
    });

    btnReject?.addEventListener('click', function () {
      saveAndClose(false);
    });

    btnCustomize?.addEventListener('click', function () {
      if (details) details.classList.remove('hidden');
      btnCustomize.classList.add('hidden');
      btnSave?.classList.remove('hidden');
      if (analyticsCheckbox instanceof HTMLInputElement) {
        analyticsCheckbox.checked = false;
      }
    });

    btnSave?.addEventListener('click', function () {
      var analytics =
        analyticsCheckbox instanceof HTMLInputElement ? analyticsCheckbox.checked : false;
      saveAndClose(analytics);
    });

    document.addEventListener('open-cookie-settings', function () {
      showBanner();
      if (details) details.classList.remove('hidden');
      btnCustomize?.classList.add('hidden');
      btnSave?.classList.remove('hidden');
      var saved = readConsent();
      if (analyticsCheckbox instanceof HTMLInputElement) {
        analyticsCheckbox.checked = Boolean(saved && saved.analytics);
      }
    });
  })();
</script>
