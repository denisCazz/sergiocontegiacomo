---
interface Props {
  title: string;
  description: string;
  items?: string[];
  ctaLabel?: string;
  ctaHref?: string;
  image?: string;
  imageAlt?: string;
}

const { title, description, items = [], ctaLabel, ctaHref, image, imageAlt } = Astro.props;
---

<div class="group relative rounded-3xl border border-neutral-border bg-white shadow-[0_4px_20px_-4px_rgba(30,58,138,0.15)] transition duration-300 hover:shadow-[0_8px_30px_-4px_rgba(30,58,138,0.25)] hover:-translate-y-1 dark:border-neutral-800 dark:bg-neutral-900 overflow-hidden">
  <div class="relative z-10 p-8">
    <div class="mb-4 flex items-start justify-between gap-4">
      <h3 class="pt-1 text-xl font-semibold leading-tight text-neutral-text dark:text-white">{title}</h3>
      {image && (
        <div class="flex h-16 w-16 shrink-0 items-center justify-center rounded-2xl bg-brand-primary/10 ring-1 ring-brand-accent/45 transition-colors duration-300 group-hover:bg-brand-primary group-hover:ring-brand-primary dark:bg-white/5 dark:ring-brand-accent/30 dark:group-hover:bg-brand-primary">
          <span
            class="h-9 w-9 bg-brand-primary transition-colors duration-300 group-hover:bg-white dark:bg-brand-light dark:group-hover:bg-white"
            style={`-webkit-mask: url('${image}') center / contain no-repeat; mask: url('${image}') center / contain no-repeat;`}
            role="img"
            aria-label={imageAlt ?? title}
          ></span>
        </div>
      )}
    </div>
    <p class="text-neutral-muted text-sm leading-relaxed mb-6 dark:text-neutral-300">{description}</p>
    {items.length > 0 && (
      <ul class="space-y-3 text-sm text-neutral-muted dark:text-neutral-300">
        {items.map((item) => (
          <li class="flex items-start gap-3">
            <span class="mt-1.5 flex-shrink-0 h-2 w-2 rounded-full bg-brand-primary dark:bg-brand-light"></span>
            <span class="leading-relaxed">{item}</span>
          </li>
        ))}
      </ul>
    )}
    {ctaLabel && ctaHref && (
      <a
        href={ctaHref}
        class="mt-6 inline-flex items-center gap-2 text-sm font-semibold text-brand-primary hover:text-brand-light transition"
      >
        {ctaLabel}
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="m9 5 7 7-7 7" />
        </svg>
      </a>
    )}
  </div>
</div>
