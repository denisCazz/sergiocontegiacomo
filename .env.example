# ===========================================
# Variabili d'ambiente - Sergio Contegiacomo
# ===========================================
# Copia questo file in .env e compila i valori

# --- Database (Postgres sulla VPS) ---
DATABASE_URL=postgresql://sergio:changeme@127.0.0.1:5432/sergio_sito

# --- Admin (unico utente) ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
AUTH_SECRET=generate-a-long-random-string

# --- Sito ---
PUBLIC_SITE_URL=https://www.sergiocontegiacomo.it
PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
PUBLIC_EVENT_EMAIL=info@sergiocontegiacomo.it

# --- Resend (email dal sito: contatti, newsletter, notifiche staff) ---
# Stesso dominio verificato che usi per il CRM se possibile.
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=noreply@sergiocontegiacomo.bitora.it
RESEND_FROM_NAME=Sergio Contegiacomo

# --- CRM Sergio (lead → clienti) ---
# Genera l'API key da Impostazioni nel CRM, poi:
BITORA_CRM_API_KEY=
# Opzionale: URL completo se diverso dal default
# BITORA_CRM_LEADS_ENDPOINT=https://sergiocontegiacomo.bitora.it/api/leads

# --- Contact Leads API (backup / secondo endpoint) ---
CONTACT_LEADS_ENDPOINT=
CONTACT_LEADS_API_KEY=

# --- Cloudflare R2 (media storage) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=sergio-media
R2_PUBLIC_URL=
